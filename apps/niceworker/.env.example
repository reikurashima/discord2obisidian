# ============================================
# NiceWorker Bot Configuration
# ============================================
# このファイルを .env にコピーして値を埋めてください
# .env は絶対にコミットしないこと！
# ============================================

# --- Discord ---
DISCORD_TOKEN=
# サーバー（ギルド）のID
GUILD_ID=
# ポモドーロ専用VCのID（作成済みのものを指定）
POMODORO_VC_ID=
# 告知用テキストチャンネルのID
ANNOUNCE_CHANNEL_ID=
# /call を打てる唯一のユーザーID（ロールではなくIDで判定する）
OWNER_USER_ID=

# --- Pomodoro ---
WORK_MINUTES=25
BREAK_MINUTES=5
# ⚠ VC名の変更機能は廃止した（WORK_CHANNEL_NAME / BREAK_CHANNEL_NAME は無い）。
#   フェーズと終了時刻はVCステータスに出す:「🍅 作業中 〜01:39」

# --- State ---
# ミュート記録の保存先。docker-compose.yaml の名前付きボリュームと合わせること
STATE_DIR=/data

# --- Timezone ---
# ⚠ 未設定だとコンテナはUTCで動き、/call end-at 23:00 が9時間ずれる
TZ=Asia/Tokyo
