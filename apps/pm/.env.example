# ============================================
# PM Bot (NiceCraft Production) Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================

# --- Discord ---
# Bot token (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# スラッシュコマンドを登録するサーバーのID（ギルドコマンドなので即時反映される）
GUILD_ID=
# このユーザーID以外からのコマンドは、ロールに関係なく全て拒否する
OWNER_USER_ID=

# --- State ---
# タスクの .md を置く場所。コンテナ内のパス。
# docker-compose.yaml のボリューム右辺と必ず一致させること。
# マイポータル（別プロセス）が同じディレクトリを読み書きする。
STATE_DIR=/data

# --- Timezone ---
# 期限・通知時刻は全てJSTとして扱う。
# （コード側もJST固定で計算するが、ログの時刻を合わせるため設定しておく）
TZ=Asia/Tokyo
