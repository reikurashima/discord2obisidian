# ============================================
# PM Bot (NiceCraft Production) Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================

# --- Discord ---
# Bot token (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# スラッシュコマンドを登録するサーバーのID（ギルドコマンドなので即時反映される）
GUILD_ID=
# このユーザーID以外からのコマンドは、ロールに関係なく全て拒否する
OWNER_USER_ID=

# --- State ---
# タスクの .md を置く場所。コンテナ内のパス。
# docker-compose.yaml のボリューム右辺と必ず一致させること。
# マイポータル（別プロセス）が同じディレクトリを読み書きする。
STATE_DIR=/data

# --- 毎日の会話走査（タスク候補の自動抽出） ---
# ⚠ MESSAGE CONTENT Intent（Developer Portal の特権Intent）が有効でないと
#    メッセージ本文が空で返り、候補が1件も出ません（実測済み）。
# 1 で有効。0 または未設定なら機能ごと無効（既存の動きのまま）。
SCAN_ENABLED=1
# 走査を始める時刻（JST）。既存の1分ティックに相乗りするので cron は不要。
SCAN_AT=09:00
# 走査から外すチャンネルID（カンマ区切り）。
# ※ "archive" カテゴリ配下は**カテゴリ名で実行時に判定**して自動で除外するので、ここに書く必要はない。
SCAN_EXCLUDE_CHANNEL_IDS=
# PM Bot 専用の通知チャンネルを別に作った場合だけ、そのIDをここに（カンマ区切り）。
# ※ Bot自身の投稿は常に読み飛ばすので、通常は空のままでよい。
SCAN_NOTIFY_CHANNEL_IDS=
# カーソルが無いチャンネルを初めて読むとき、何時間ぶん遡るか。
SCAN_FIRST_RUN_HOURS=24
# 1チャンネルから1回に取る上限。超えたら新しい方を優先し、カーソルは進める。
SCAN_MAX_MESSAGES_PER_CHANNEL=200
# claude-runner のキュー（コンテナ内のパス）。
# docker-compose.yaml のマウント先と必ず一致させること。
RUNNER_QUEUE_DIR=/runner-queue
# 走査に使うモデル。
SCAN_RUNNER_MODEL=haiku
# 結果待ちの上限（ミリ秒）。超えたらその日は失敗として記録し、翌日に持ち越さない。
SCAN_JOB_TIMEOUT_MS=600000
# 候補ができたときのDMに載せるリンク（任意。空なら省かれる）。
PORTAL_PM_URL=

# --- Timezone ---
# 期限・通知時刻は全てJSTとして扱う。
# （コード側もJST固定で計算するが、ログの時刻を合わせるため設定しておく）
TZ=Asia/Tokyo
