# ============================================
# claude-runner Configuration
# ============================================
# Copy this file to .env. 必須の項目はありません（全て既定値を持っています）。
# NEVER commit .env to version control!
# ============================================

# --- パス（コンテナ内） ---
# docker-compose.yaml の volumes 右辺と必ず一致させること
QUEUE_DIR=/queue
HEALTH_FILE=/queue/health.json
# ジョブごとの使い捨て作業ディレクトリ。コンテナ内に閉じる（マウントしない）
WORK_DIR=/work

# --- 通知 ---
# 認証切れを知らせる Discord webhook。
# 未設定ならログに出すだけで、本体は止まらない。
RUNNER_WEBHOOK_URL=

# --- 動作の調整（通常は変えなくてよい） ---
# inbox を見に行く間隔（ミリ秒）
POLL_INTERVAL_MS=2000
# health.json の更新間隔（要件: 60秒）
HEALTH_INTERVAL_MS=60000
# 認証の疎通確認の間隔（要件: 1日1回）
AUTH_CHECK_INTERVAL_MS=86400000
# result / failed の保持日数
RETENTION_DAYS=14
# タイムアウト時 SIGTERM から SIGKILL までの猶予（ミリ秒）
KILL_GRACE_MS=5000
# 添付ファイル（files/）1件あたりの上限（バイト。既定 20MB）。超えたら rejected
MAX_ATTACHMENT_BYTES=20971520
# 対応するジョブが無い files/ の中身を消すまでの猶予（ミリ秒。既定 1時間）
ORPHAN_FILE_AGE_MS=3600000

# --- Timezone ---
# ⚠ 入れ忘れるとUTCで動く。compose の environment にも入れてある
TZ=Asia/Tokyo

# ============================================
# ⚠ ANTHROPIC_API_KEY をここに書かないこと。
#    この runner は /root/.claude のサブスク認証で動かす前提。
#    APIキーが環境にあると claude がそちらを優先し、従量課金が発生する。
#    （保険として、子プロセスの env からは実行時に必ず削除している）
# ============================================
