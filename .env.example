# ============================================
# Discord Bot Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# --- Discord ---
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_note_channel_id
DISCORD_DAILY_CHANNEL_ID=your_daily_channel_id
# Optional: channel that pastes messages into an Obsidian .canvas file
DISCORD_CANVAS_CHANNEL_ID=your_canvas_channel_id

# --- Storage Mode ---
# "dropbox" or "local" (NAS local filesystem)
STORAGE_MODE=local

# --- Dropbox (required if STORAGE_MODE=dropbox) ---
DROPBOX_CLIENT_ID=your_dropbox_app_key
DROPBOX_CLIENT_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token
DROPBOX_FOLDER_PATH=/discord-notes

# --- Local NAS Storage (required if STORAGE_MODE=local) ---
# Path INSIDE the container. Must match the RIGHT side of the volume mount in docker-compose.yml.
# (The NAS-side real path is the LEFT side of that mount, e.g. /volume1/syncdata/library)
LOCAL_VAULT_PATH=/vault
